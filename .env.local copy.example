# Google Earth Engine Service Account Credentials
# Create a Google Cloud Service Account with Earth Engine Resource Viewer / Earth Engine Admin permissions
# Register the service account in your Earth Engine project (https://code.earthengine.google.com/)
EARTH_ENGINE_PROJECT_ID=
EARTH_ENGINE_CLIENT_EMAIL=
EARTH_ENGINE_PRIVATE_KEY=

# TiDB Cloud Starter / MySQL Database Connection String
# Example format: mysql://<username>:<password>@<tidb_host>:4000/<database_name>?ssl={"rejectUnauthorized":true}
DATABASE_URL=
